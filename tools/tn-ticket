#!/usr/bin/env bash
# Repository-local tn-ticket helper.
#
# The production copy may live outside this checkout.  Keep this copy small and
# testable so ticket-queue behavior can be reviewed in normal PRs.
set -uo pipefail

REPO="${TN_TICKET_REPO:-SzeChunYiu/factory-tickets}"
DEFAULT_PROJECT="${TN_TICKET_PROJECT:-grocery}"

for d in /projects/hep/fs9/shared/nnbar/billy/_shared/bin "$HOME/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$PATH:" in *":$d:"*) ;; *) [ -x "$d/gh" ] && PATH="$d:$PATH";; esac
done
export PATH

if [ -z "${GH_TOKEN:-}" ]; then
  for f in \
      /projects/hep/fs9/shared/nnbar/billy/_shared/.tn-ticket-token \
      "$HOME/.tn-ticket-token" \
      /tmp/.tn-ticket-token; do
    if [ -r "$f" ]; then export GH_TOKEN="$(tr -d '\n' < "$f")"; break; fi
  done
fi

cmd="${1:-list}"; shift || true

PROJECT="$DEFAULT_PROJECT"
BODY=""
REASON=""
STALE_MIN=120
POS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --project)   PROJECT="$2"; shift 2 ;;
    --body)      BODY="$2"; shift 2 ;;
    --reason)    REASON="$2"; shift 2 ;;
    --stale-min) STALE_MIN="$2"; shift 2 ;;
    *)           POS+=("$1"); shift ;;
  esac
done

gh_() { gh --repo "$REPO" "$@"; }

retry() {
  local tries=0
  while :; do
    if "$@"; then return 0; fi
    tries=$((tries+1))
    [ "$tries" -ge 3 ] && return 1
    sleep $((tries*2))
  done
}

case "$cmd" in
  claim)
    worker="${POS[0]:-unknown}"
    plabel="project:$PROJECT"
    wlabel="worker:$worker"

    existing=$(retry gh_ issue list -l factory:claimed -l "$plabel" -l "$wlabel" --state open \
               --limit 1 --json number,title,body \
               --jq 'if length == 0 then empty else .[0] | "\(.number)|\(.title)|\(.body)" end' 2>/dev/null)
    existing_number=$(printf '%s' "$existing" | cut -d'|' -f1)
    if [ -n "$existing" ] && printf '%s' "$existing_number" | grep -Eq '^[0-9]+$'; then
      et=$(printf '%s' "$existing" | cut -d'|' -f2)
      eb=$(printf '%s' "$existing" | cut -d'|' -f3-)
      echo "$existing_number" >&2
      printf '# %s\n\n%s\n' "$et" "$eb"
      exit 0
    fi

    for attempt in 1 2 3 4 5 6 7 8; do
      ids=$(retry gh_ issue list -l factory:open -l "$plabel" --state open \
            --limit 1 --json number,title,body,createdAt \
            --jq 'sort_by(.createdAt) | .[0].number' 2>/dev/null)
      if [ -z "$ids" ] || [ "$ids" = "null" ]; then
        if [ "$attempt" -le 3 ]; then sleep $((attempt * 3)); continue; fi
        echo "tn-ticket: queue empty for $plabel" >&2
        exit 1
      fi
      n="$ids"

      retry gh_ label create "$wlabel" --color cccccc 2>/dev/null || true
      if ! retry gh_ issue edit "$n" \
            --add-label factory:claimed --add-label "$wlabel" \
            --remove-label factory:open >/dev/null 2>&1; then
        continue
      fi

      labels=$(retry gh_ issue view "$n" --json labels --jq '.labels[].name' 2>/dev/null)
      workers=$(printf '%s\n' "$labels" | grep -E '^worker:' | sort)
      n_workers=$(printf '%s\n' "$workers" | grep -c .)
      if [ "$n_workers" -gt 1 ]; then
        winner=$(printf '%s\n' "$workers" | head -1)
        if [ "$winner" != "$wlabel" ]; then
          retry gh_ issue edit "$n" --remove-label "$wlabel" >/dev/null 2>&1
          continue
        fi
        printf '%s\n' "$workers" | tail -n +2 | while read -r loser_lbl; do
          [ -n "$loser_lbl" ] && retry gh_ issue edit "$n" --remove-label "$loser_lbl" >/dev/null 2>&1 || true
        done
      fi

      title=$(retry gh_ issue view "$n" --json title --jq .title)
      body=$(retry gh_ issue view "$n" --json body --jq .body)
      echo "$n" >&2
      printf '# %s\n\n%s\n' "$title" "$body"
      exit 0
    done

    echo "tn-ticket: no claimable ticket after 8 attempts" >&2
    exit 1
    ;;

  done)
    n="${POS[0]:?usage: tn-ticket done <id>}"
    retry gh_ issue edit "$n" --add-label factory:done --remove-label factory:claimed >/dev/null 2>&1
    retry gh_ issue close "$n" >/dev/null
    ;;

  list)
    plabel="project:$PROJECT"
    open=$(retry gh_ issue list -l factory:open -l "$plabel" --state open --json number --jq length 2>/dev/null)
    held=$(retry gh_ issue list -l factory:claimed -l "$plabel" --state open --json number --jq length 2>/dev/null)
    done_=$(retry gh_ issue list -l factory:done -l "$plabel" --state closed --json number --jq length --limit 1000 2>/dev/null)
    echo "project=$PROJECT  open=${open:-?}  claimed=${held:-?}  done=${done_:-?}"
    ;;

  *)
    echo "tn-ticket: unknown or unsupported command '$cmd' (use claim|done|list)" >&2
    exit 2
    ;;
esac
