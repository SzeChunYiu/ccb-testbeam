# vis.mac — optional visualization (build with -DCCB_ENABLE_VIS=ON).
/vis/open OGL
/vis/viewer/set/autoRefresh false
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 60 30
/vis/viewer/set/style surface
/vis/scene/add/axes 0 0 0 5 cm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton green
/vis/modeling/trajectories/drawByParticleID-0/set proton red
/vis/modeling/trajectories/drawByParticleID-0/set deuteron yellow
/vis/scene/endOfEventAction accumulate
/vis/viewer/set/autoRefresh true
/ccb/particle proton
/ccb/energy 100 MeV
/run/beamOn 5
