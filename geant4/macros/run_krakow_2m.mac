# Macro file for hibeam_g4 - 2M event regenerated campaign
# Provenance: #1311 regenerated paper MC
# Sampler: linear_node_pdf_exact_inverse_v1 + measured_table_support_truncate_v1
# Weight: unit event weight (direct sampling)
# Cross section: source-bound 190 MeV p+d Table-VI projection; see geant4/src_patch/sigma_pd_cm_190.source.json
#
/run/initialize

/ElGen/E 190. MeV
/ElGen/TargetThickness 2.3 mm
/ElGen/Beamspot 10 mm
/ElGen/CSFile ./sigma_pd_cm_190.txt

/run/beamOn 2000000
