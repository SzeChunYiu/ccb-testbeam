{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccb-closure-record.schema.json",
  "title": "CCB Project Closure Record",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "evidence",
    "acceptance"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "READY",
        "IN_PROGRESS",
        "DONE",
        "CORRECTED",
        "BLOCKED_COMPUTE",
        "BLOCKED_EXTERNAL",
        "SUPERSEDED",
        "FAILED_INFORMATIVE"
      ]
    },
    "issue": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "passed"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}